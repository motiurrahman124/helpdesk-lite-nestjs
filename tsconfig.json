{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "cookie-parser": ["./src/types/cookie-parser.d.ts"],
      "@nestjs/config": ["./node_modules/@nestjs/config/dist/index.d.ts"],
      "@nestjs/jwt": ["./node_modules/@nestjs/jwt/dist/index.d.ts"],
      "@nestjs/swagger": ["./node_modules/@nestjs/swagger/dist/index.d.ts"]
    }
  }
}
